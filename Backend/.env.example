# Copy this file to .env and fill in the values before running docker compose up

# MySQL
DB_ROOT_PASSWORD=your_mysql_root_password
DB_CONNECTION_STRING=Server=db;Port=3306;Database=copytrade_db;User=root;Password=your_mysql_root_password;

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars

# Grafana Loki (Grafana Cloud)
# URI and Username are pre-configured in appsettings.json
# Only the API token (password) must be supplied here
LOKI_PASSWORD=your_grafana_cloud_api_token
